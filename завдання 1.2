def build_pyramid(n):
  """Функція виконує побудову піраміди з цілих чисел, де N — найбільша цифра."""
  if not (1 <= n <= 10):
    print("Помилка: N має бути цілим числом у діапазоні від 1 до 10.")
    return

  print(f"\nОтриманий рисунок для N = {n}:")

  for i in range(1, n + 1):
    row_elements = [str(i)] * i
    print(" " * (n - i) + " ".join(row_elements))

  for i in range(n - 1, 0, -1):
    row_elements = [str(i)] * i
    print(" " * (n - i) + " ".join(row_elements))
def main():
  print("Завдання 2: Побудова піраміди")
  while True:
    try:
      n = int(
          input("Введіть найбільшу цифру у піраміді N (ціле число від 1 до 10): ")
      )
      if 1 <= n <= 10:
        break
      else:
        print("Помилка! N має бути цілим числом від 1 до 10.")
    except ValueError:
      print("Помилка! Будь ласка, введіть ціле число.")

  build_pyramid(n)
if __name__ == "__main__":
  main()
